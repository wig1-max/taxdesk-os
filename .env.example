# ============================================================
# TaxDesk OS environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# ============================================================

# --- Supabase (project: create in ap-south-1 / Mumbai region) ---
# Safe for browser (public):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses RLS. Never expose to the browser,
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- PAN field encryption (AES-256-GCM via node:crypto) ---
# 32 random bytes, base64. Generate with:
#   openssl rand -base64 32
# or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SERVER ONLY. Rotating this key requires re-encrypting stored PANs.
PAN_ENCRYPTION_KEY=

# --- Rate limiting (Upstash Redis) ---
# REQUIRED for production: distributed rate limiting on the public
# upload route and signed-URL issuance. Without these, limiting
# degrades to per-instance memory (dev only) and logs a warning.
# Create a free Redis at https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- App ---
# Public, externally reachable origin of THIS app. Used to build client
# upload links (/upload/[token]) and password reset/setup redirect URLs.
# REQUIRED in production and must be the real domain (https), never
# localhost — otherwise clients receive unreachable links. The app fails
# closed if this is unset when NODE_ENV=production.
#   local:      http://localhost:3000
#   staging:    https://staging.taxdesk.example
#   production: https://app.taxdesk.example
APP_BASE_URL=http://localhost:3000

# --- Auth email (password reset / staff setup links) ---
# Sending reset/setup emails needs SMTP configured on the SUPABASE side
# (Dashboard -> Authentication -> Emails / SMTP), not in this file. Also
# add your domain's /reset-password to Supabase -> Authentication -> URL
# Configuration -> Redirect URLs, e.g.
#   https://app.taxdesk.example/reset-password
# (plus http://localhost:3000/reset-password for local dev, where Mailpit
# catches the mail). Without SMTP, staff invites still work via the
# one-time temporary password shown on the Users page.
